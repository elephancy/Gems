{
  "schemaVersion": 1,
  "id": "gems",
  "version": "${version}",
  "name": "Gems of Fate",
  "description": "Standalone gem powers, energy, items, and progression.",
  "icon": "assets/gems/icon.png",
  "authors": [
    "feel"
  ],
  "contact": {
    "homepage": "https://github.com/elephancy/Gems",
    "sources": "https://github.com/elephancy/Gems",
    "issues": "https://github.com/elephancy/Gems/issues"
  },
  "custom": {
    "modmenu": {
      "links": {
        "credits": "https://github.com/elephancy/Gems/blob/main/credits.md"
      }
    }
  },
  "license": "AGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.feel.gems.GemsMod"
    ],
    "client": [
      "com.feel.gems.client.GemsClientMod"
    ],
    "modmenu": [
      "com.feel.gems.client.modmenu.GemsModMenu"
    ]
  },
  "mixins": [
    "gems.mixins.json",
    "gems.client.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0+26.3",
    "minecraft": "~26.3"
  },
  "suggests": {
    "modmenu": "*"
  }
